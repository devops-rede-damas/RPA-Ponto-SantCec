# ============================================================
# RPA-Ponto-SantCec — Configuração
# ============================================================

# SFTP Santa Cecília (origem — download do AFD.txt)
SANTA_CECILIA_HOST=
SANTA_CECILIA_PORT=
SANTA_CECILIA_USER=
SANTA_CECILIA_PASS=

# SFTP Totvs RM TCloud (destino — upload do AFD_STACECILIA.txt)
TOTVS_HOST=
TOTVS_PORT=
TOTVS_USER=
TOTVS_PASS=
TOTVS_REMOTE_DIR=/Ponto

# Diretório local para salvar o arquivo
LOCAL_DIR=D:\PONTO\Coleta Batidas\Todos os REPs

# Timeout global do script em segundos (padrão: 300 = 5 min)
SCRIPT_TIMEOUT=300

# Timeout de conexão SFTP em segundos (padrão: 30)
SFTP_TIMEOUT=30
